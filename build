#!/bin/bash
# ----------------------------
# C++ Builder - Build Tool
# ----------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
SETTINGS_FILE="$SCRIPT_DIR/build_settings"

# Initialize settings if not present
if [ ! -f "$SETTINGS_FILE" ]; then
    cat > "$SETTINGS_FILE" <<EOL
FIGLET_COMPILED=1
FIGLET_RUNNING=1
FIGLET_DONE=0
BUILD_MODE=release
VERSION="1.0.0"
EOL
fi

source "$SETTINGS_FILE"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check figlet
if ! command -v figlet &> /dev/null; then
    echo -e "${RED}Figlet not installed. Run: sudo apt install figlet${NC}"
    exit 1
fi

# ----------------------------
# Terminal UI for settings
# ----------------------------
tui_settings() {
    while true; do
        clear
        echo -e "${CYAN}Build Settings TUI${NC}\n"
        echo "1) Toggle COMPILED banner (current: $FIGLET_COMPILED)"
        echo "2) Toggle RUNNING banner (current: $FIGLET_RUNNING)"
        echo "3) Toggle DONE banner (current: $FIGLET_DONE)"
        echo "4) Change build mode (current: $BUILD_MODE)"
        echo "5) Exit and save"
        echo
        read -p "Select an option: " opt
        case $opt in
            1) FIGLET_COMPILED=$((1-FIGLET_COMPILED)) ;;
            2) FIGLET_RUNNING=$((1-FIGLET_RUNNING)) ;;
            3) FIGLET_DONE=$((1-FIGLET_DONE)) ;;
            4)
                echo "Select build mode:"
                select mode in release debug; do
                    [ -n "$mode" ] && BUILD_MODE="$mode" && break
                done
                ;;
            5) break ;;
            *) echo "Invalid option!"; sleep 1 ;;
        esac
    done

    cat > "$SETTINGS_FILE" <<EOL
FIGLET_COMPILED=$FIGLET_COMPILED
FIGLET_RUNNING=$FIGLET_RUNNING
FIGLET_DONE=$FIGLET_DONE
BUILD_MODE=$BUILD_MODE
VERSION="$VERSION"
EOL
    echo "Settings saved!"
    sleep 1
}

# ----------------------------
# Command handling
# ----------------------------
if [ "$1" == "help" ]; then
    echo -e "${CYAN}Build Tool Help:${NC}"
    echo "Usage:"
    echo "  build <file.cpp>"
    echo "  build -co <file.cpp>     # compile only (no run, no I/O)"
    echo "  build -case             # input: in.case, output: in.out"
    echo "  build settings"
    echo "  build clean <file>"
    echo "  build version"
    echo "  build help"
    exit 0
elif [ "$1" == "settings" ]; then
    tui_settings
    exit 0
elif [ "$1" == "clean" ]; then
    if [ -z "$2" ]; then
        echo -e "${RED}Error: specify file to clean.${NC}"
        exit 1
    fi
    TARGET="${2%.cpp}"
    if [ -f "$TARGET" ]; then
        rm "$TARGET"
        echo -e "${GREEN}Deleted $TARGET${NC}"
    else
        echo -e "${YELLOW}$TARGET does not exist.${NC}"
    fi
    exit 0
elif [ "$1" == "version" ]; then
    echo -e "${CYAN}Build Tool Version:${NC} $VERSION"
    exit 0
fi

# ----------------------------
# Modes
# ----------------------------
COMPILE_ONLY=0
CASE_MODE=0

if [ "$1" == "-co" ]; then
    COMPILE_ONLY=1
    SRC="$2"
elif [ "$1" == "--case" ]; then
    CASE_MODE=1
    SRC="main.cpp"
    TARGET="main_exec"
    IN_FILE="in.case"
    OUT_FILE="in.out"
else
    SRC="$1"
fi

if [ -z "$SRC" ]; then
    echo -e "${RED}Error: no source file specified.${NC}"
    exit 1
fi

TARGET="${SRC%.cpp}"

if [ ! -f "$SRC" ]; then
    echo -e "${RED}Error: source file $SRC not found.${NC}"
    exit 1
fi

# ----------------------------
# Compiler flags
# ----------------------------
CXXFLAGS="-std=c++23 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wsign-conversion \
-Wnull-dereference -Wdouble-promotion -Wformat=2 -fstack-protector-strong \
-fsanitize=address,undefined -fno-omit-frame-pointer -fdiagnostics-color=always \
-ftime-report -v"

[ "$BUILD_MODE" == "debug" ] && CXXFLAGS="$CXXFLAGS -O0 -g3"
[ "$BUILD_MODE" == "release" ] && CXXFLAGS="$CXXFLAGS -O2"

# ----------------------------
# Compile
# ----------------------------
echo -e "${CYAN}⚒️  Compiling $SRC ...${NC}"
g++ $CXXFLAGS "$SRC" -o "$TARGET"

# ----------------------------
# Post-build
# ----------------------------
if [ $? -eq 0 ]; then
    [ "$FIGLET_COMPILED" -eq 1 ] && figlet -c "COMPILED!" || echo -e "${GREEN}✅ Build successful!${NC}"

    if [ "$COMPILE_ONLY" -eq 1 ]; then
        echo -e "${GREEN}🧱 Compile-only mode: skipping execution.${NC}"
        exit 0
    fi

    if [ "$CASE_MODE" -eq 1 ]; then
        echo -e "${YELLOW}🚀 Running in case mode...${NC}"
        ./"$TARGET" < "$IN_FILE" > "$OUT_FILE"
        echo -e "${GREEN}Output written to $OUT_FILE${NC}"
    else
        [ "$FIGLET_RUNNING" -eq 1 ] && figlet -c "RUNNING"
        echo -e "${YELLOW}🚀 Program is running...${NC}"
        ./"$TARGET"
    fi

    echo
    [ "$FIGLET_DONE" -eq 1 ] && figlet -c "DONE"
    echo -e "${GREEN}🏁 Program finished.${NC}"
else
    figlet -c "FAILED"
    echo -e "${RED}❌ Build failed.${NC}"
fi
